# Whale Street Sales Bot settings.
# Copy to .env (cp .env.example .env) and fill in .env. Never commit .env.
# Keep comments on their own lines; don't put "# ..." after a value.

# ---- X API keys (developer.x.com > your app > Keys and tokens) ----
# Generate the Access Token AFTER setting app permissions to "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

### X API 
CONSUMER_KEY=
SECRET_KEY=
BEARER_TOKEN=

# true = print posts to the logs only. false = post to X for real.
DRY_RUN=true

# ---- Optional: uncomment to change. Defaults are in config.py ----
# CONTRACT_ADDRESS=0x01f33271d74a9dcc91798c7232d3d788da93a1f6
# COLLECTION_NAME=Whale Street
# EMOJI=🐳
# Skip sales under this USD value (0 = post everything).
# MIN_PRICE_USD=0
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
# Ethereum RPC for ENS names; set to off to show plain addresses.
# ENS_RPC_URL=https://ethereum-rpc.publicnode.com
# Only on the very first run: backfill sales starting from this block.
# START_BLOCK=
